{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Agent",
  "version": "0.3.1",
  "identifier": "dev.localagent.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "dragDropEnabled": false,
        "title": "Local Agent",
        "width": 1360,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "backgroundColor": "#17191c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Local coding tasks, clearly reviewed.",
    "resources": {
      "../browser-helper/": "browser-helper/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
